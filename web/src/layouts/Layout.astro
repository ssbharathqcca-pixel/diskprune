---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="DiskPrune - The native macOS storage manager to reclaim disk space instantly." />
    <meta name="viewport" content="width=device-width" />
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content="DiskPrune" />
    <meta property="og:description" content="DiskPrune is the ultimate native macOS storage manager to reclaim disk space instantly." />
    <meta property="og:type" content="website" />
    
    <title>{title}</title>
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "DiskPrune",
        "operatingSystem": "macOS 14.0+",
        "applicationCategory": "UtilitiesApplication",
        "offers": {
          "@type": "Offer",
          "price": "19.00",
          "priceCurrency": "USD"
        }
      }
    </script>
  </head>
  <body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col">
    <slot />
    <footer class="mt-auto border-t border-slate-800 py-8 px-6 text-sm text-slate-400">
      <div class="max-w-4xl mx-auto flex flex-wrap gap-x-6 gap-y-2 justify-center">
        <a href="/" class="hover:text-slate-200">Home</a>
        <a href="/download" class="hover:text-slate-200">Download</a>
        <a href="/pricing" class="hover:text-slate-200">Pricing</a>
        <a href="/privacy" class="hover:text-slate-200">Privacy</a>
        <a href="/refunds" class="hover:text-slate-200">Refunds</a>
        <a href="/support" class="hover:text-slate-200">Support</a>
        <a href="/license" class="hover:text-slate-200">License</a>
      </div>
    </footer>
  </body>
</html>
