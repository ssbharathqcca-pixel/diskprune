---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Support — DiskPrune">
  <main class="max-w-3xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-bold mb-6">Support</h1>
    <p class="text-lg text-slate-300 mb-4">
      Email <a href="mailto:support@diskprune.com" class="text-blue-400 hover:underline">support@diskprune.com</a>.
    </p>
    <p class="text-lg text-slate-300 mb-4">
      Include the email you used at checkout if the question is about a missing license key.
      We never put the key on the success page or in a URL — check spam for
      licenses@diskprune.com.
    </p>
    <p class="text-lg text-slate-300 mb-4">
      DiskPrune moves files to Trash only. It does not empty Trash, permanently delete, or
      delete APFS snapshots. If macOS shows an unidentified-developer warning, use System
      Settings → Privacy & Security → Open Anyway until a notarized build is posted.
    </p>
    <p class="text-lg text-slate-300">
      <a href="/refunds" class="text-blue-400 hover:underline">Refund policy</a>
      ·
      <a href="/privacy" class="text-blue-400 hover:underline">Privacy</a>
    </p>
  </main>
</Layout>
