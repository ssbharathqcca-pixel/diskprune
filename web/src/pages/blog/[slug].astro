---
import Layout from "../../layouts/Layout.astro";
import { GUIDE_PAGES } from "../../lib/guides.mjs";
import { BUY_URL, PRICE, GUIDES } from "../../lib/product.mjs";

export function getStaticPaths() {
  return Object.entries(GUIDE_PAGES).map(([slug, page]) => ({
    params: { slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const others = GUIDES.filter((g) => !Astro.url.pathname.replace(/\/$/, "").endsWith(g.href));
---

<Layout title={`${page.title} — DiskPrune`} description={page.description}>
  <main class="prose-page mx-auto max-w-prose px-6 py-16">
    <p class="text-sm text-muted"><a href="/">DiskPrune</a> · Guides</p>
    <h1 class="mt-4 text-4xl font-semibold leading-tight tracking-tight">{page.title}</h1>
    <p class="mt-4 text-lg text-muted leading-relaxed">{page.description}</p>

    {page.sections.map((section) => (
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">{section.h2}</h2>
        {section.p.map((para) => (
          <p class="mt-4 text-muted leading-relaxed">{para}</p>
        ))}
      </section>
    ))}

    <section class="mt-12 border border-hairline bg-panel p-6" style="border-radius: var(--radius-md);">
      <p class="font-semibold text-ink">Scan is free. Cleanup is {PRICE} lifetime.</p>
      <p class="mt-2 text-sm text-muted">
        DiskPrune moves only what you approve to Trash. It does not empty Trash,
        delete snapshots, or delete Docker.raw.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={BUY_URL}>Buy {PRICE}</a>
        <a class="btn btn-secondary" href="/download">Download</a>
      </div>
    </section>

    <nav class="mt-12 text-sm">
      <p class="font-medium text-ink">More guides</p>
      <ul class="mt-2 space-y-1">
        {others.map((g) => (
          <li><a href={g.href}>{g.title}</a></li>
        ))}
        <li><a href="/mac-disk-space-analyzer">Mac disk space analyzers compared</a></li>
        <li><a href="/vs-cleanmymac">DiskPrune vs CleanMyMac</a></li>
      </ul>
    </nav>
  </main>
</Layout>
