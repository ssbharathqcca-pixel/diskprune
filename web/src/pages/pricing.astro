---
import Layout from "../layouts/Layout.astro";
import { BUY_URL, PRICE, SEATS } from "../lib/product.mjs";
---

<Layout
  title="Pricing — DiskPrune"
  description="DiskPrune is $19 once. No subscription. Scan is free. Cleanup on up to 3 Macs. 14-day refund."
>
  <main class="mx-auto max-w-prose px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Pricing</h1>
    <p class="mt-3 text-lg text-muted">One price. No subscription.</p>

    <div class="mt-10 border border-hairline bg-panel p-8" style="border-radius: var(--radius-lg);">
      <p class="text-5xl font-semibold tracking-tight">{PRICE}</p>
      <p class="mt-2 text-muted">Lifetime · {SEATS} Macs · scan free</p>
      <ul class="mt-6 list-disc space-y-2 pl-5 text-muted">
        <li>Native SwiftUI for macOS 14+</li>
        <li>Moves approved items to Trash only</li>
        <li>Does not delete APFS snapshots</li>
        <li>Does not delete Docker.raw</li>
        <li>14-day refund</li>
      </ul>
      <a class="btn btn-primary mt-8" href={BUY_URL}>Buy DiskPrune Lifetime</a>
    </div>
  </main>
</Layout>
