---
import Layout from "../layouts/Layout.astro";
import { BUY_URL, PRICE, FOUNDING_PRICE, FOUNDING_SEATS, SEATS, DOWNLOAD_URL } from "../lib/product.mjs";
---

<Layout
  title="Pricing — DiskPrune"
  description="DiskPrune is $19 once. No subscription. Scan is free. Cleanup on up to 3 Macs. 14-day refund."
>
  <main class="mx-auto max-w-prose px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Pricing</h1>
    <p class="mt-3 text-lg text-muted">One price. No subscription. Founding rate while it lasts.</p>

    <div class="mt-10 border border-hairline bg-panel p-8" style="border-radius: var(--radius-lg);">
      <div class="flex items-baseline gap-3">
        <p class="text-5xl font-semibold tracking-tight">{FOUNDING_PRICE}</p>
        <p class="text-2xl text-muted line-through">{PRICE}</p>
      </div>
      <p class="mt-2 text-muted">Founding price · first {FOUNDING_SEATS} customers · then {PRICE}</p>
      <p class="mt-1 text-muted">Lifetime · {SEATS} Macs · scan always free</p>
      <ul class="mt-6 list-disc space-y-2 pl-5 text-muted">
        <li>Native SwiftUI for macOS 14+, notarized and Developer ID signed</li>
        <li>Moves approved items to Trash only — never permanent deletion</li>
        <li>Does not delete APFS snapshots</li>
        <li>Does not delete Docker.raw</li>
        <li>14-day refund</li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={BUY_URL}>Buy DiskPrune — {FOUNDING_PRICE}</a>
        <a class="btn btn-secondary" href={DOWNLOAD_URL}>Download free</a>
      </div>
      <p class="mt-3 text-sm text-subtle">Price rises to {PRICE} after the first {FOUNDING_SEATS} customers.</p>
    </div>
  </main>
</Layout>
