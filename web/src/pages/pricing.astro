---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing — DiskPrune">
  <main class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl font-bold mb-4">Pricing</h1>
    <p class="text-xl text-slate-300 mb-8">One price. No subscription.</p>
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-10 inline-block text-left">
      <p class="text-5xl font-bold mb-2">$19</p>
      <p class="text-slate-400 mb-6">Lifetime · 3 Macs · scan free</p>
      <ul class="text-slate-300 space-y-2 mb-8 list-disc list-inside">
        <li>Native SwiftUI for macOS 14+</li>
        <li>Moves approved items to Trash only</li>
        <li>Does not delete APFS snapshots</li>
        <li>14-day refund</li>
      </ul>
      <a href="https://buy.stripe.com/eVqeVc8nd9wx39efNdaR200" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg inline-block">
        Buy DiskPrune Lifetime
      </a>
    </div>
  </main>
</Layout>
