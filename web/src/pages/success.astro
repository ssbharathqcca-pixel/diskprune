---
import Layout from "../layouts/Layout.astro";
import { DOWNLOAD_URL, loadingCopy } from "../lib/checkout-status.mjs";
---

<Layout
  title="Thank You — DiskPrune"
  description="Checkout status only. DiskPrune never shows a license key in the browser. If payment is confirmed, the key is in your email."
>
  <main class="mx-auto max-w-prose px-6 py-16 text-center">
    <div class="border border-hairline bg-panel p-10" style="border-radius: var(--radius-lg);">
      <h1 id="status-heading" class="text-3xl font-semibold tracking-tight text-ink">
        Checking your payment
      </h1>
      <p id="status-loading" class="mt-3 text-muted">
        {loadingCopy()}
      </p>
      <p id="status-body" class="mt-4 text-lg text-muted"></p>
      <p class="mt-8 text-sm text-subtle">
        DiskPrune never shows a license key on this page. If payment is confirmed, the key is in your email. Paste it in DiskPrune → Settings → Licence.
      </p>
      <div class="mt-10">
        <a href={DOWNLOAD_URL} class="btn btn-secondary">
          Download DiskPrune
        </a>
      </div>
    </div>
  </main>

  <script>
    import { mountSuccessPage } from "../lib/checkout-status.mjs";
    mountSuccessPage({
      document,
      search: window.location.search,
      fetchImpl: fetch.bind(window),
    });
  </script>
</Layout>
