---
import Layout from '../layouts/Layout.astro';
import { DOWNLOAD_URL, loadingCopy } from '../lib/checkout-status.mjs';
---

<Layout title="Thank You — DiskPrune">
  <main class="max-w-3xl mx-auto px-6 py-20 text-center">
    <div class="bg-slate-800 p-10 rounded-xl border border-slate-700">
      <h1 id="status-heading" class="text-4xl font-bold mb-4 text-slate-100">
        Checking your payment
      </h1>
      <p id="status-loading" class="text-slate-400 animate-pulse">
        {loadingCopy()}
      </p>
      <p id="status-body" class="text-xl text-slate-300 mt-4"></p>
      <p class="mt-8 text-sm text-slate-400">
        DiskPrune never shows a license key on this page. If payment is confirmed, the key is in your email. Paste it in DiskPrune → Settings → Licence.
      </p>
      <div class="mt-10">
        <a href={DOWNLOAD_URL} class="inline-block bg-slate-700 hover:bg-slate-600 text-white font-bold py-3 px-8 rounded-lg text-lg">
          Download DiskPrune
        </a>
      </div>
    </div>
  </main>

  <script>
    import { mountSuccessPage } from "../lib/checkout-status.mjs";
    mountSuccessPage({
      document,
      search: window.location.search,
      fetchImpl: fetch.bind(window),
    });
  </script>
</Layout>
