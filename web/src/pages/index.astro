---
import Layout from "../layouts/Layout.astro";
import {
  BUY_URL,
  PRICE,
  FOUNDING_PRICE,
  FOUNDING_SEATS,
  TAGLINE,
  DESCRIPTION,
  GUIDES,
  COMPARE_PAGES,
  COMPARISON,
  DOWNLOAD_URL,
} from "../lib/product.mjs";
---

<Layout title="DiskPrune — native macOS storage intelligence" description={DESCRIPTION}>
  <main>
    <div class="border-b border-hairline bg-[#f0f9eb] dark:bg-[#1a2e14]">
      <p class="mx-auto max-w-site px-6 py-3 text-sm font-medium text-[#2d6a1b] dark:text-[#7ec96b]">
        Founding price: {FOUNDING_PRICE} for the first {FOUNDING_SEATS} customers — goes to {PRICE} after.
        <a class="underline underline-offset-2 hover:no-underline" href={BUY_URL}>Lock in {FOUNDING_PRICE} →</a>
      </p>
    </div>

    <section class="mx-auto max-w-site px-6 pt-16 pb-10 sm:pt-24">
      <p class="text-sm font-medium uppercase tracking-[0.14em] text-muted">
        Native SwiftUI · macOS 14+ · Notarized
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
        See why your Mac is full. Move only what you approve to Trash.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        Scan is free. Cleanup is a {FOUNDING_PRICE} founding license — {PRICE} after the first {FOUNDING_SEATS}. DiskPrune never empties
        Trash, never deletes APFS snapshots, and never touches Docker.raw.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={BUY_URL}>Buy lifetime — {FOUNDING_PRICE} <span class="opacity-60 line-through ml-1">{PRICE}</span></a>
        <a class="btn btn-secondary" href={DOWNLOAD_URL}>Download free</a>
      </div>
      <p class="mt-4 text-sm text-subtle">
        Up to 3 Macs · 14-day refund · opens instantly, no security warnings · license key by email.
      </p>
    </section>

    <section class="mx-auto max-w-site px-6 pb-16">
      <figure>
        <img
          class="shot"
          src="/screenshots/overview.png"
          width="1100"
          height="720"
          alt="DiskPrune Overview after a scan: Macintosh HD capacity bar, category sidebar, and Developer storage selected."
        />
        <figcaption class="mt-3 text-sm text-subtle">
          Overview after a real scan. The capacity bar includes a not-examined region.
          DiskPrune does not colour unknown bytes as if it understood them.
        </figcaption>
      </figure>
    </section>

    <section class="border-y border-hairline bg-panel">
      <div class="mx-auto grid max-w-site gap-10 px-6 py-16 sm:grid-cols-3">
        <div>
          <p class="text-sm font-medium text-muted">1 · Understand</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight">Storage autopsy</h2>
          <p class="mt-2 text-muted leading-relaxed">
            Categories, a capacity bar, and an honest not-examined hatch. The question
            is “why is it full?”, not “how big is the number?”.
          </p>
        </div>
        <div>
          <p class="text-sm font-medium text-muted">2 · Review</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight">Plan, then dry run</h2>
          <p class="mt-2 text-muted leading-relaxed">
            You pick items. DiskPrune builds a plan, rejects ancestor/child overlap,
            and shows a dry run. Nothing has changed yet.
          </p>
        </div>
        <div>
          <p class="text-sm font-medium text-muted">3 · Trash only</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight">Receipt, not a boast</h2>
          <p class="mt-2 text-muted leading-relaxed">
            Estimated recoverable. Moved to Trash. Storage immediately available.
            Empty Trash yourself, in Finder, when you are ready.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 py-16">
      <h2 class="text-3xl font-semibold tracking-tight">The actual app</h2>
      <p class="mt-3 max-w-2xl text-muted leading-relaxed">
        Screenshots from the native Visual QA build on <code class="font-mono text-sm">main</code>.
        This is DiskPrune, not a marketing mock.
      </p>
      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        <figure>
          <img class="shot" src="/screenshots/scan.png" width="1100" height="720" alt="Scan progress with a determinate bar and named probes." />
          <figcaption class="mt-3 text-sm text-subtle">Scan. Determinate progress, named probes. Cancel is available. No fake percentage.</figcaption>
        </figure>
        <figure>
          <img class="shot" src="/screenshots/cleanup.png" width="1100" height="720" alt="Cleanup list with Safe, Review, Advanced, and Protected sections. Protected items have no checkbox." />
          <figcaption class="mt-3 text-sm text-subtle">Cleanup. Protected items have no checkbox. Advanced is review-only until you know what it is.</figcaption>
        </figure>
        <figure>
          <img class="shot" src="/screenshots/dry-run.png" width="720" height="520" alt="Dry-run sheet: Nothing has changed yet. Storage becomes available after you empty the Trash." />
          <figcaption class="mt-3 text-sm text-subtle">Dry run. “Nothing has changed yet.” Storage becomes available after you empty the Trash.</figcaption>
        </figure>
        <figure>
          <img class="shot" src="/screenshots/receipt.png" width="720" height="520" alt="Receipt with three lines: Estimated recoverable, Moved to Trash, Storage immediately available." />
          <figcaption class="mt-3 text-sm text-subtle">Receipt. Three accounting lines. Files stay in Trash until you empty it.</figcaption>
        </figure>
        <figure>
          <img class="shot" src="/screenshots/snapshots.png" width="1100" height="720" alt="Snapshots destination. Copy states DiskPrune never deletes snapshots. No delete control." />
          <figcaption class="mt-3 text-sm text-subtle">Snapshots. Inspect only. There is no delete control.</figcaption>
        </figure>
      </div>
    </section>

    <section id="compare" class="border-y border-hairline bg-panel">
      <div class="mx-auto max-w-site px-6 py-16">
        <h2 class="text-3xl font-semibold tracking-tight">Honest comparison</h2>
        <p class="mt-3 max-w-2xl text-muted leading-relaxed">
          DaisyDisk owns sunburst. DiskBuddy owns eight charts. DissectMac is a free
          treemap. CleanMyMac is a subscription suite. DiskPrune owns why the bytes
          exist, and a cleanup path that can only move to Trash.
        </p>
        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[52rem] text-left text-sm">
            <thead>
              <tr class="border-b border-hairline">
                <th class="sticky left-0 bg-panel py-3 pr-4 font-medium text-muted">Feature</th>
                {COMPARISON.columns.map((col) => (
                  <th class:list={["py-3 px-3 font-semibold", col.id === "diskprune" ? "text-ink" : "text-muted"]}>
                    {col.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {COMPARISON.rows.map((row) => (
                <tr class="border-b border-hairline align-top">
                  <th class="sticky left-0 bg-panel py-3 pr-4 font-medium text-ink">{row.feature}</th>
                  {COMPARISON.columns.map((col) => (
                    <td class:list={["py-3 px-3", col.id === "diskprune" ? "text-ink" : "text-muted"]}>
                      {row[col.id]}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm text-subtle">
          If you only want a sunburst, buy DaisyDisk. If you want eight novelty charts,
          DiskBuddy has them. If you want to understand System Data, DerivedData, and
          Docker.raw — and move only what you approve to Trash — that is DiskPrune.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 py-16">
      <h2 class="text-3xl font-semibold tracking-tight">What DiskPrune will not do</h2>
      <ul class="mt-6 grid gap-3 text-muted sm:grid-cols-2">
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Permanently delete files. There is no <code class="font-mono text-sm">removeItem</code> fallback.</li>
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Empty Trash. That is your action, in Finder.</li>
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Delete APFS local snapshots. The Snapshots screen is inspect-only.</li>
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Delete <code class="font-mono text-sm">Docker.raw</code> or Docker data directories.</li>
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Claim that moving files to Trash has already made that space available.</li>
        <li class="border border-hairline bg-panel px-5 py-4" style="border-radius: var(--radius-md);">Scan your files off the Mac. The disk map stays on the device.</li>
      </ul>
    </section>

    <section id="guides" class="border-y border-hairline bg-panel">
      <div class="mx-auto max-w-site px-6 py-16">
        <h2 class="text-3xl font-semibold tracking-tight">Guides</h2>
        <p class="mt-3 max-w-2xl text-muted">The three sentences people actually search. Written to match the binary, not to overclaim.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {[...GUIDES, ...COMPARE_PAGES].map((g) => (
            <a href={g.href} class="block border border-hairline bg-paper p-5 no-underline hover:border-ink/20" style="border-radius: var(--radius-md);">
              <p class="font-semibold text-ink">{g.title}</p>
              <p class="mt-1 text-sm text-muted">{g.blurb}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="install" class="mx-auto max-w-site px-6 py-16">
      <h2 class="text-2xl font-semibold tracking-tight">Opens with a double-click</h2>
      <p class="mt-3 max-w-2xl text-muted leading-relaxed">
        DiskPrune is notarized and Developer ID signed. Drag it to Applications,
        double-click — macOS opens it without any warning. No right-click, no
        System Settings detour.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-secondary" href={DOWNLOAD_URL}>Download DiskPrune.dmg →</a>
      </div>
    </section>

    <section class="border-t border-hairline bg-panel">
      <div class="mx-auto max-w-site px-6 py-16 text-center">
        <p class="text-2xl font-semibold tracking-tight">{TAGLINE}</p>
        <p class="mt-3 text-muted">Scan free. {FOUNDING_PRICE} founding lifetime for the first {FOUNDING_SEATS}. 3 Macs. 14-day refund.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href={BUY_URL}>Buy DiskPrune — {FOUNDING_PRICE} <span class="opacity-60 line-through ml-1">{PRICE}</span></a>
          <a class="btn btn-secondary" href={DOWNLOAD_URL}>Download free</a>
        </div>
        <p class="mt-4 text-sm text-subtle">Founding price rises to {PRICE} after the first {FOUNDING_SEATS} customers.</p>
      </div>
    </section>
  </main>
</Layout>
